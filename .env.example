# ---------------------------------------------------------------------------
# Contact form email (Resend — https://resend.com)
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values. `.env.local` is
# gitignored; this template is committed so the setup is reproducible.

# API key from https://resend.com/api-keys
RESEND_API_KEY=

# The verified sender. Must be on a domain you've verified in Resend
# (https://resend.com/domains) — i.e. dwarkastudio.in must be verified
# before this address can send. Until then you can use onboarding@resend.dev,
# but that sandbox sender only delivers to the address that owns the Resend
# account, so the visitor auto-reply will fail.
CONTACT_FROM_EMAIL=Dwarka Studios <info@dwarkastudio.in>

# Where website enquiries land.
CONTACT_TO_EMAIL=info@dwarkastudio.in
